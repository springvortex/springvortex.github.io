{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "lang": "zh-CN",
  "start_url": "{{ site.baseurl }}/?source=pwa",
  "scope": "{{ site.baseurl }}/",
  "display": "standalone",
  "background_color": "#f5f6f8",
